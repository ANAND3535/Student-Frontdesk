<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Question_And_Answer_Required</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(TRIM(Question__c)), ISBLANK(Answer__c))</errorConditionFormula>
    <errorMessage>Enter a question and an answer.</errorMessage>
    <errorDisplayField>Question__c</errorDisplayField>
</ValidationRule>
